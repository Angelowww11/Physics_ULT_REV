  "components": [
    {
      "name": "Primary button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The main action in the current workspace context.",
      "html": "<button class=\"ds-button ds-primary\">Start practice</button>",
      "css": ".ds-button{display:inline-flex;justify-content:center;align-items:center;gap:8px;border:1px solid var(--line);border-radius:7px;padding:10px 14px;min-height:40px;background:var(--surface);color:var(--ink);font:600 12px/1.5 \"DM Sans\",sans-serif;text-decoration:none;cursor:pointer;transition:background .16s ease-out,border-color .16s ease-out}.ds-button:hover{background:var(--surface-2);border-color:var(--accent)}.ds-button:focus-visible{outline:2px solid var(--accent);outline-offset:4px;}.ds-button:disabled{opacity:.55;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}:host-context([data-reduce-motion=true]) .ds-button{transition:none}.ds-primary{background:var(--accent);border-color:transparent;color:#fff}.ds-primary:hover{background:var(--accent);border-color:transparent;filter:brightness(.96)}:host-context([data-mode=dark]) .ds-primary{color:#121b2e}"
    },
    {
      "name": "Secondary button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "A supporting action on a paper surface.",
      "html": "<button class=\"ds-button\">Save question</button>",
      "css": ".ds-button{display:inline-flex;justify-content:center;align-items:center;gap:8px;border:1px solid var(--line);border-radius:7px;padding:10px 14px;min-height:40px;background:var(--surface);color:var(--ink);font:600 12px/1.5 \"DM Sans\",sans-serif;text-decoration:none;cursor:pointer;transition:background .16s ease-out,border-color .16s ease-out}.ds-button:hover{background:var(--surface-2);border-color:var(--accent)}.ds-button:focus-visible{outline:2px solid var(--accent);outline-offset:4px;}.ds-button:disabled{opacity:.55;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button{transition:none}}:host-context([data-reduce-motion=true]) .ds-button{transition:none}.ds-button[aria-pressed=true]{background:var(--accent-soft);border-color:var(--accent);color:var(--accent-ink)}"
    },
    {
      "name": "Search input",
      "kind": "input",
      "refersTo": "search-input",
      "description": "The compact topic search in the workspace header.",
      "html": "<label class=\"ds-search-label\" for=\"ds-topic\">Search all module notes</label><input class=\"ds-search\" id=\"ds-topic\" type=\"search\" placeholder=\"Find a topic…\">",
      "css": ".ds-search-label{position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0}.ds-search{background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:7px;padding:9px 12px;width:214px;max-width:100%;min-height:37px;font:12px \"DM Sans\",sans-serif;caret-color:var(--accent)}.ds-search::placeholder{color:var(--muted)}.ds-search:focus-visible{outline:2px solid var(--accent);outline-offset:4px;}"
    },
    {
      "name": "Main navigation",
      "kind": "nav",
      "refersTo": "navigation-current",
      "description": "Flat navigation with an accent line on the current page.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a href=\"#study\" aria-current=\"page\">Study</a><a href=\"#practice\">Practice</a><a href=\"#review\">Review</a><a href=\"#sources\">Originals</a></nav>",
      "css": ".ds-nav{display:flex;align-items:stretch;gap:27px;height:76px;border-bottom:1px solid var(--line)}.ds-nav a{position:relative;display:flex;align-items:center;text-decoration:none;font:600 13px \"DM Sans\",sans-serif;color:var(--muted)}.ds-nav a:hover{color:var(--ink)}.ds-nav a[aria-current=page]{color:var(--accent-ink)}.ds-nav a[aria-current=page]:after{content:\"\";position:absolute;bottom:0;left:0;right:0;height:2px;background:var(--accent)}.ds-nav a:focus-visible{outline:2px solid var(--accent);outline-offset:4px;}"
    },
    {
      "name": "Review count",
      "kind": "chip",
      "refersTo": "count-chip",
      "description": "A noninteractive count beside the Review navigation label.",
      "html": "<span class=\"ds-count\">3</span>",
      "css": ".ds-count{display:inline-block;font:11px/18px \"DM Sans\",sans-serif;min-width:18px;text-align:center;border-radius:5px;background:var(--accent-soft);color:var(--muted);padding:0 4px}"
    },
    {
      "name": "Workspace panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "A flat paper container for workspace forms or content.",
      "html": "<section class=\"ds-panel\"><h2>Practice settings</h2><p>Choose a module for your next set.</p></section>",
      "css": ".ds-panel{background:var(--surface);color:var(--ink);border:1px solid var(--line);border-radius:12px;padding:27px;min-width:0;font:15px/1.65 \"DM Sans\",sans-serif}.ds-panel h2{font:600 21px/1.3 Bricolage,sans-serif;letter-spacing:-.025em;margin:0 0 19px}.ds-panel p{margin:0}"
    },
    {
      "name": "Answer choice",
      "kind": "button",
      "refersTo": "answer-choice",
      "description": "A full-width answer choice in the practice margin.",
      "html": "<button class=\"ds-choice\"><span>A</span><span>The electric field is zero.</span></button>",
      "css": ".ds-choice{display:flex;align-items:center;gap:10px;text-align:left;width:100%;min-height:44px;border:1px solid var(--line);border-radius:7px;padding:11px;background:var(--surface);color:var(--ink);font:12px/1.6 \"DM Sans\",sans-serif;cursor:pointer}.ds-choice>span:first-child{font-size:11px;min-width:19px;color:var(--muted)}.ds-choice:hover:enabled{border-color:var(--accent);background:var(--accent-soft)}.ds-choice:focus-visible{outline:2px solid var(--accent);outline-offset:4px;}.ds-choice:disabled{opacity:1;cursor:default}.ds-choice.ds-correct{background:var(--positive-bg);border-color:var(--positive-ink)}.ds-choice.ds-wrong{background:var(--danger-bg);border-color:var(--danger-ink)}"
    }
  ],
  "narrative": {
    "northStar": "Field Notes",
    "overview": "Field Notes uses cool paper, clear rules, and restrained color. The study workspace extends the existing notebook identity. The full notes remain the main reading surface.\n\nThe existing palette and bundled fonts remain the visual authority. The earlier website and standalone notebook retain their own presentation.",
    "keyCharacteristics": [
      "Cool paper surfaces with thin rules.",
      "Bricolage headings with DM Sans reading text.",
      "Theme-aware accents and explicit answer states.",
      "A reading column with a narrower practice margin."
    ],
    "rules": [
      {
        "name": "The Shared Palette Rule",
        "body": "Use the selected theme’s semantic variables for new surfaces.",
        "section": "colors"
      },
      {
        "name": "The Reading Scale Rule",
        "body": "Apply the saved reading scale to notes and worked solutions. Keep control text independent of that scale.",
        "section": "typography"
      },
      {
        "name": "The Workspace Depth Rule",
        "body": "Keep the workspace flat at rest. Use neutral shadows for search results and the appearance dialog.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the existing semantic color variables.",
      "Do keep the bundled heading and body fonts.",
      "Do preserve source figures and full explanations.",
      "Do keep new workspace labels at or above 11px.",
      "Do keep solution-type text available to assistive technology in the workspace.",
      "Do obey saved and system reduced-motion preferences."
    ],
    "donts": [
      "Don’t copy workspace size overrides into the standalone notebook.",
      "Don’t use the practice margin as the main reading column.",
      "Don’t use color alone to identify correct and incorrect answers.",
      "Don’t use inherited small labels or offset shadows as patterns for new surfaces."
    ]
  }
}
